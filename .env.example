# =============================================================================
# NetSleuth-AI — Environment Configuration Example (.env.example)
# =============================================================================
# USAGE:
#   1. Copy this file to .env:
#        cp .env.example .env
#   2. Fill in real values or keep defaults for local development.
#
# SECURITY:
#   .env is listed in .gitignore and MUST NEVER be committed to version control.
#   This file (.env.example) contains ONLY default placeholders.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application Layer & Runtime Settings
# -----------------------------------------------------------------------------
# Application metadata
APP_NAME=NetSleuth-AI
APP_VERSION=1.0.0

# Deployment environment: 'development', 'staging', 'production', or 'test'
APP_ENV=development

# Logging verbosity level: 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'
LOG_LEVEL=INFO

# Base API v1 prefix
API_V1_PREFIX=/api/v1

# Allowed CORS origins (comma-separated). 
# Note: In production, wildcard (*) is forbidden and will be stripped for security.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# 2. Database Settings (PostgreSQL)
# -----------------------------------------------------------------------------
# PostgreSQL credentials used by docker-compose for the database container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=netsleuth
POSTGRES_PORT=15432

# SQLAlchemy Async connection URL (asyncpg driver)
# - From host machine (FastAPI running locally outside Docker):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:15432/netsleuth
# - When backend is running inside Docker network:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/netsleuth

# -----------------------------------------------------------------------------
# 3. MinIO Object Storage Settings (S3-Compatible)
# -----------------------------------------------------------------------------
# Root/Admin credentials for MinIO server
# (Must be at least 3 characters for user and 8 characters for password)
MINIO_ROOT_USER=netsleuth_dev
MINIO_ROOT_PASSWORD=netsleuth_dev_secret

# MinIO S3 API Endpoint:
# - From host machine (FastAPI running locally on host):
MINIO_ENDPOINT=localhost:9000
# - Inside Docker network:
# MINIO_ENDPOINT=minio:9000

# MinIO S3 Region identifier (MinIO is region-agnostic; used for S3 compatibility)
MINIO_REGION=us-east-1

# Whether to enforce TLS/SSL for MinIO connection (false for local development)
MINIO_USE_SSL=false

# Authoritative Bucket Names (must match buckets initialized in MinIO)
MINIO_BUCKET_EVIDENCE=netsleuth-evidence
MINIO_BUCKET_ZEEK=netsleuth-zeek
MINIO_BUCKET_DATASETS=netsleuth-datasets
MINIO_BUCKET_MODELS=netsleuth-models
MINIO_BUCKET_REPORTS=netsleuth-reports

# -----------------------------------------------------------------------------
# 4. Authentication & Security (JWT)
# -----------------------------------------------------------------------------
# Cryptographic secret key for signing JWT access tokens.
# Generate a secure 256-bit key in production using: openssl rand -hex 32
JWT_SECRET_KEY=dev_secret_key_change_in_production_f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2

# JWT Signing algorithm (e.g. HS256)
JWT_ALGORITHM=HS256

# JWT Access token expiration time in minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# 5. Local AI & Forensic Copilot (Ollama)
# -----------------------------------------------------------------------------
# Ollama local inference API endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Ollama LLM model tag for investigations and query generation
OLLAMA_MODEL=qwen2.5-coder:latest

# -----------------------------------------------------------------------------
# 6. Frontend Client Configuration (Vite)
# -----------------------------------------------------------------------------
# Base URL for backend API consumed by Vite React frontend
VITE_API_BASE_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# 7. Testing & Integration Flags (Optional)
# -----------------------------------------------------------------------------
# Set to 1 to run slow real-world PCAP Zeek extraction integration tests
RUN_REAL_PCAP_TESTS=0
