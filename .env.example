# =============================================================================
# NetSleuth-AI — Environment Configuration Example
# .env.example
# =============================================================================
# USAGE:
#   Copy this file to .env and fill in real values:
#     cp .env.example .env
#
# SECURITY:
#   .env is listed in .gitignore and MUST NEVER be committed.
#   This file (.env.example) contains ONLY placeholders — no real credentials.
#
# =============================================================================

# -----------------------------------------------------------------------------
# MinIO Object Storage Credentials
# LOCAL DEVELOPMENT ONLY
# -----------------------------------------------------------------------------
# Root/admin credentials for the MinIO server.
# Must be at least 3 chars (user) and 8 chars (password).

MINIO_ROOT_USER=<development-user>
MINIO_ROOT_PASSWORD=<development-password>

# -----------------------------------------------------------------------------
# MinIO Application Connection Settings
# Used by backend services to connect to MinIO
# -----------------------------------------------------------------------------

# Inside Docker: use the service name as hostname
MINIO_ENDPOINT=minio:9000

# From host machine for direct access / testing:
# MINIO_ENDPOINT=localhost:9000

# Region — MinIO is region-agnostic; set to any value for S3 compat
MINIO_REGION=us-east-1

# Whether to use TLS for MinIO connection (false for local dev)
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# Bucket Names
# Must match the buckets created by minio-init service
# -----------------------------------------------------------------------------

MINIO_BUCKET_EVIDENCE=netsleuth-evidence
MINIO_BUCKET_ZEEK=netsleuth-zeek
MINIO_BUCKET_DATASETS=netsleuth-datasets
MINIO_BUCKET_MODELS=netsleuth-models
MINIO_BUCKET_REPORTS=netsleuth-reports
