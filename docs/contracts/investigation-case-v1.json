{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netsleuth.ai/schemas/investigation-case-v1.json",
  "title": "NetSleuth AI Investigation Case",
  "description": "M3 Investigation Engine output contract consumed by M4 Reporting Engine.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "case_id",
    "title",
    "status",
    "severity",
    "created_at",
    "updated_at",
    "investigator",
    "timeline",
    "entities",
    "evidence_references"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "investigation-case-v1"
    },

    "case_id": {
      "type": "string",
      "pattern": "^CASE-[A-Za-z0-9_-]+$"
    },

    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },

    "description": {
      "type": "string",
      "maxLength": 10000
    },

    "status": {
      "type": "string",
      "enum": [
        "open",
        "investigating",
        "review",
        "closed"
      ]
    },

    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },

    "created_at": {
      "type": "string",
      "format": "date-time"
    },

    "updated_at": {
      "type": "string",
      "format": "date-time"
    },

    "closed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },

    "investigator": {
      "$ref": "#/$defs/Investigator"
    },

    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100
      },
      "uniqueItems": true
    },

    "findings": {
      "type": "array",
      "description": "References to findings produced by M1 Analysis Engine.",
      "items": {
        "$ref": "#/$defs/FindingReference"
      }
    },

    "timeline": {
      "type": "array",
      "description": "Chronologically relevant events reconstructed by M3.",
      "items": {
        "$ref": "#/$defs/TimelineEvent"
      }
    },

    "entities": {
      "type": "array",
      "description": "Entities involved in the investigation and their relationships.",
      "items": {
        "$ref": "#/$defs/InvestigationEntity"
      }
    },

    "evidence_references": {
      "type": "array",
      "description": "References to evidence supporting the investigation.",
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      }
    },

    "assessment": {
      "$ref": "#/$defs/InvestigationAssessment"
    },

    "attack_chain": {
      "$ref": "#/$defs/AttackChain"
    },

    "mitre_mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MitreMapping"
      }
    }
  },

  "$defs": {

    "Investigator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "investigator_id",
        "name"
      ],
      "properties": {
        "investigator_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },

    "FindingReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id"
      ],
      "properties": {
        "finding_id": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "primary",
            "supporting",
            "related"
          ]
        }
      }
    },

    "TimelineEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "timestamp",
        "event_type",
        "description"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },

        "timestamp": {
          "type": "string",
          "format": "date-time"
        },

        "event_type": {
          "type": "string",
          "enum": [
            "network",
            "dns",
            "http",
            "tls",
            "session",
            "flow",
            "artifact",
            "finding",
            "alert",
            "investigation",
            "evidence"
          ]
        },

        "description": {
          "type": "string"
        },

        "source_entity_id": {
          "type": [
            "string",
            "null"
          ]
        },

        "target_entity_id": {
          "type": [
            "string",
            "null"
          ]
        },

        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "InvestigationEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "entity_type"
      ],
      "properties": {
        "entity_id": {
          "type": "string"
        },

        "entity_type": {
          "type": "string",
          "enum": [
            "host",
            "ip",
            "domain",
            "url",
            "session",
            "flow",
            "ioc",
            "artifact",
            "finding"
          ]
        },

        "label": {
          "type": "string"
        },

        "role": {
          "type": "string",
          "enum": [
            "primary",
            "related",
            "supporting"
          ]
        },

        "first_seen": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },

        "last_seen": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },

    "EvidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_type"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },

        "evidence_type": {
          "type": "string",
          "enum": [
            "pcap",
            "flow",
            "session",
            "dns",
            "http",
            "tls",
            "artifact",
            "log",
            "finding"
          ]
        },

        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },

        "hash": {
          "type": [
            "string",
            "null"
          ]
        },

        "hash_algorithm": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "SHA-256",
            "SHA-512",
            "MD5",
            null
          ]
        }
      }
    },

    "InvestigationAssessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssessmentItem"
          }
        },

        "inferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssessmentItem"
          }
        },

        "hypotheses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssessmentItem"
          }
        }
      }
    },

    "AssessmentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement"
      ],
      "properties": {
        "statement": {
          "type": "string"
        },

        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "AttackChain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "none",
            "potential",
            "confirmed"
          ]
        },

        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AttackChainStage"
          }
        }
      }
    },

    "AttackChainStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "name"
      ],
      "properties": {
        "stage_id": {
          "type": "string"
        },

        "name": {
          "type": "string"
        },

        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },

        "event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "MitreMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technique_id",
        "technique_name"
      ],
      "properties": {
        "tactic_id": {
          "type": [
            "string",
            "null"
          ]
        },

        "tactic_name": {
          "type": [
            "string",
            "null"
          ]
        },

        "technique_id": {
          "type": "string"
        },

        "technique_name": {
          "type": "string"
        },

        "source_finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
