{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netsleuth.ai/schemas/report-v1.json",
  "title": "NetSleuth AI Report V1 Contract",
  "description": "M4 Report V1 Canonical Schema Contract. STATUS: FROZEN.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "case_id",
    "generated_at",
    "summary",
    "findings",
    "timeline",
    "evidence_integrity"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "report-v1"
    },
    "report_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generator_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "$ref": "#/$defs/ReportSummary"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReportFinding"
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReportTimelineEvent"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReportEntity"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReportRelationship"
      }
    },
    "evidence_integrity": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReportEvidenceRecord"
      }
    },
    "assessment": {
      "$ref": "#/$defs/ReportAssessment"
    },
    "provenance": {
      "$ref": "#/$defs/ReportProvenance"
    }
  },
  "$defs": {
    "ReportSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_title",
        "case_status",
        "total_findings",
        "total_timeline_events",
        "total_evidence_references"
      ],
      "properties": {
        "case_title": {
          "type": "string"
        },
        "case_description": {
          "type": [
            "string",
            "null"
          ]
        },
        "case_status": {
          "type": "string"
        },
        "total_findings": {
          "type": "integer",
          "minimum": 0
        },
        "total_timeline_events": {
          "type": "integer",
          "minimum": 0
        },
        "total_evidence_references": {
          "type": "integer",
          "minimum": 0
        },
        "verified_evidence_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "mismatched_evidence_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unverified_evidence_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "ReportFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "title",
        "severity",
        "confidence"
      ],
      "properties": {
        "finding_id": {
          "type": "string"
        },
        "finding_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "informational"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "evidence_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ReportTimelineEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "timestamp",
        "title"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "entity_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ReportEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "entity_type",
        "value"
      ],
      "properties": {
        "entity_id": {
          "type": "string"
        },
        "entity_type": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "ReportRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship_id",
        "source_entity_id",
        "target_entity_id",
        "relationship_type"
      ],
      "properties": {
        "relationship_id": {
          "type": "string"
        },
        "source_entity_id": {
          "type": "string"
        },
        "target_entity_id": {
          "type": "string"
        },
        "relationship_type": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ReportEvidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "case_id",
        "evidence_type",
        "verification_status"
      ],
      "properties": {
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_id": {
          "type": "string"
        },
        "case_id": {
          "type": "string"
        },
        "evidence_type": {
          "type": "string",
          "enum": [
            "pcap",
            "flow",
            "session",
            "dns",
            "http",
            "tls",
            "artifact",
            "log",
            "finding"
          ]
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "calculated_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "hash_algorithm": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "SHA-256",
            "SHA-512",
            "MD5",
            null
          ]
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "verified",
            "unverified",
            "mismatch",
            "tampered"
          ]
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "collected_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ingested_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "provenance": {
          "type": [
            "object",
            "null"
          ]
        },
        "chain_of_custody": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "custodian_id",
              "action",
              "timestamp"
            ],
            "properties": {
              "custodian_id": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "signature": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "ReportAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fact_id",
              "statement"
            ],
            "properties": {
              "fact_id": {
                "type": "string"
              },
              "statement": {
                "type": "string"
              },
              "confidence": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "ReportProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acquisition_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "collector_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
