{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netsleuth.ai/schemas/investigation-case-v1.3.json",
  "title": "NetSleuth AI Investigation Case",
  "description": "M3 Investigation Engine output contract consumed by M4 Reporting Engine. V1.3 Investigation Engine expansion.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "case_id",
    "title",
    "status",
    "severity",
    "created_at",
    "updated_at",
    "investigator",
    "timeline",
    "entities",
    "relationships",
    "evidence_references"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "investigation-case-v1.3"
    },

    "case_id": {
      "type": "string",
      "pattern": "^(CASE-[A-Za-z0-9_-]+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
    },

    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },

    "description": {
      "type": "string",
      "maxLength": 10000
    },

    "status": {
      "type": "string",
      "enum": [
        "open",
        "investigating",
        "review",
        "closed"
      ]
    },

    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },

    "created_at": {
      "type": "string",
      "format": "date-time"
    },

    "updated_at": {
      "type": "string",
      "format": "date-time"
    },

    "closed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },

    "investigator": {
      "$ref": "#/$defs/Investigator"
    },

    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100
      },
      "uniqueItems": true
    },

    "findings": {
      "type": "array",
      "description": "References to findings produced by M1 Analysis Engine.",
      "items": {
        "$ref": "#/$defs/FindingReference"
      }
    },

    "timeline": {
      "type": "array",
      "description": "Chronologically relevant events reconstructed by M3.",
      "items": {
        "$ref": "#/$defs/TimelineEvent"
      }
    },

    "entities": {
      "type": "array",
      "description": "Entities involved in the investigation.",
      "items": {
        "$ref": "#/$defs/InvestigationEntity"
      }
    },

    "relationships": {
      "type": "array",
      "description": "Deterministic edges correlating entities.",
      "items": {
        "$ref": "#/$defs/Relationship"
      }
    },

    "evidence_references": {
      "type": "array",
      "description": "References to evidence supporting the investigation.",
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      }
    },

    "assessment": {
      "$ref": "#/$defs/InvestigationAssessment"
    },

    "attack_chain": {
      "$ref": "#/$defs/AttackChain"
    },

    "mitre_provenance": {
      "$ref": "#/$defs/MitreProvenance"
    },

    "mitre_mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MitreMapping"
      }
    }
  },

  "$defs": {

    "Relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship_id",
        "source_entity_id",
        "relationship_type",
        "target_entity_id",
        "confidence"
      ],
      "properties": {
        "relationship_id": {
          "type": "string"
        },
        "source_entity_id": {
          "type": "string"
        },
        "relationship_type": {
          "type": "string"
        },
        "target_entity_id": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "first_seen": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_seen": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },

    "Investigator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "investigator_id",
        "name"
      ],
      "properties": {
        "investigator_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },

    "FindingReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id"
      ],
      "properties": {
        "finding_id": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "primary",
            "supporting",
            "related"
          ]
        }
      }
    },

    "TimelineEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "timestamp",
        "event_type",
        "description"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },

        "timestamp": {
          "type": "string",
          "format": "date-time"
        },

        "event_type": {
          "type": "string",
          "enum": [
            "network",
            "dns",
            "http",
            "tls",
            "session",
            "flow",
            "artifact",
            "finding",
            "alert",
            "investigation",
            "evidence"
          ]
        },

        "description": {
          "type": "string"
        },

        "source_entity_id": {
          "type": [
            "string",
            "null"
          ]
        },

        "target_entity_id": {
          "type": [
            "string",
            "null"
          ]
        },

        "entity_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "InvestigationEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "entity_type"
      ],
      "properties": {
        "entity_id": {
          "type": "string"
        },

        "entity_type": {
          "type": "string",
          "enum": [
            "host",
            "ip",
            "domain",
            "url",
            "session",
            "flow",
            "protocol_event",
            "ioc",
            "artifact",
            "finding"
          ]
        },

        "label": {
          "type": "string"
        },

        "role": {
          "type": "string",
          "enum": [
            "primary",
            "related",
            "supporting"
          ]
        },

        "first_seen": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },

        "last_seen": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },

    "EvidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_type"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },

        "evidence_type": {
          "type": "string",
          "enum": [
            "pcap",
            "flow",
            "session",
            "dns",
            "http",
            "tls",
            "artifact",
            "log",
            "finding"
          ]
        },

        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },

        "hash": {
          "type": [
            "string",
            "null"
          ]
        },

        "hash_algorithm": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "SHA-256",
            "SHA-512",
            "MD5",
            null
          ]
        }
      }
    },

    "InvestigationAssessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hypotheses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Hypothesis"
          }
        },
        "hypothesis_validations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HypothesisValidation"
          }
        },
        "root_causes": {
          "type": "array",
          "description": "Multiple entries represent competing/candidate root-cause conclusions.",
          "items": {
            "$ref": "#/$defs/RootCause"
          }
        },
        "impact_assessments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImpactAssessment"
          }
        }
      }
    },

    "Hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "statement",
        "hypothesis_type",
        "status",
        "confidence",
        "supporting_evidence_ids"
      ],
      "properties": {
        "hypothesis_id": { "type": "string" },
        "statement": { "type": "string" },
        "hypothesis_type": { "type": "string" },
        "status": {
          "type": "string",
          "enum": [
            "POTENTIAL",
            "SUPPORTED",
            "PARTIALLY_SUPPORTED",
            "DISFAVORED",
            "REJECTED",
            "UNRESOLVED"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "supporting_evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "supporting_finding_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "related_entity_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "related_mitre_mapping_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "first_seen": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "last_seen": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "supporting_reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "missing_evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "HypothesisValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_id",
        "hypothesis_id",
        "validation_status",
        "confidence",
        "validated_at"
      ],
      "properties": {
        "validation_id": { "type": "string" },
        "hypothesis_id": { "type": "string" },
        "validation_status": {
          "type": "string",
          "enum": [
            "VALIDATED",
            "REJECTED",
            "INCONCLUSIVE"
          ]
        },
        "supporting_evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "contradicting_evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "supporting_reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "contradicting_reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "missing_evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "validated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },

    "RootCause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_cause_id",
        "statement",
        "status",
        "confidence",
        "supporting_evidence_ids"
      ],
      "properties": {
        "root_cause_id": { "type": "string" },
        "statement": { "type": "string" },
        "status": {
          "type": "string",
          "enum": [
            "POTENTIAL",
            "SUPPORTED",
            "PARTIALLY_SUPPORTED",
            "UNRESOLVED"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "supporting_hypothesis_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "supporting_evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "supporting_finding_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "rationale": {
          "type": "array",
          "items": { "type": "string" }
        },
        "missing_evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "ImpactAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "impact_id",
        "category",
        "statement",
        "status",
        "confidence",
        "supporting_evidence_ids"
      ],
      "properties": {
        "impact_id": { "type": "string" },
        "category": { "type": "string" },
        "statement": { "type": "string" },
        "status": {
          "type": "string",
          "enum": [
            "OBSERVED",
            "INFERRED",
            "POTENTIAL"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "supporting_evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "supporting_finding_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "affected_entity_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "rationale": {
          "type": "array",
          "items": { "type": "string" }
        },
        "missing_evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "AttackChain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "none",
            "potential",
            "confirmed"
          ]
        },

        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AttackChainStage"
          }
        }
      }
    },

    "AttackChainStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "name"
      ],
      "properties": {
        "stage_id": {
          "type": "string"
        },

        "name": {
          "type": "string"
        },

        "timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },

        "event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "MitreProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "domain", "version", "knowledge_profile_id"],
      "properties": {
        "framework": { "type": "string" },
        "domain": { "type": "string" },
        "version": { "type": "string" },
        "knowledge_profile_id": { "type": "string" }
      }
    },

    "MitreMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technique_id",
        "technique_name"
      ],
      "properties": {
        "tactic_id": {
          "type": [
            "string",
            "null"
          ]
        },

        "tactic_name": {
          "type": [
            "string",
            "null"
          ]
        },

        "technique_id": {
          "type": "string"
        },

        "technique_name": {
          "type": "string"
        },

        "behavior_id": {
          "type": ["string", "null"]
        },

        "mapping_status": {
          "type": "string",
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "POTENTIAL",
            "INSUFFICIENT_EVIDENCE",
            "NOT_APPLICABLE"
          ]
        },

        "mapping_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },

        "rationale": {
          "type": ["string", "null"]
        },

        "source_finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },

        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },

        "first_seen": {
          "type": ["string", "null"],
          "format": "date-time"
        },

        "last_seen": {
          "type": ["string", "null"],
          "format": "date-time"
        },

        "detection_strategy_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },

        "analytic_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },

        "data_component_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },

        "channels": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    }
  }
}
